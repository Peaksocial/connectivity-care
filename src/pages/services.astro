---
import Layout from '../layouts/Layout.astro';

const services = [
  {
    id: 'svc-support-coordination', slug: 'support-coordination', icon: 'i-check',
    title: 'NDIS Support Coordination',
    img: '/images/cafe.jpg', alt: 'A man smiling at an outdoor café table', imgStyle: 'object-position:50% 40%',
    text: 'Helping you make the most of your NDIS plan and ensuring your supports work together to help you achieve your goals.',
    items: ['Understanding your plan', 'Coordinating your supports', 'Preparing for plan reviews'],
    ask: 'Ask about Support Coordination', more: true,
  },
  {
    id: 'svc-daily-living', slug: 'daily-living', icon: 'i-wrench',
    title: 'Assistance with daily living',
    img: '/images/sewing.jpg', alt: 'A young woman working on a sewing project at a sewing machine', imgStyle: 'object-position:50% 45%',
    text: 'Our team helps with everyday tasks at home and in your personal routine, so the day runs the way you want it to.',
    items: ['Personal care', 'Meal preparation', 'Household chores'],
    ask: 'Ask about daily living support',
  },
  {
    id: 'svc-independent-living', slug: 'independent-living', icon: 'i-doc',
    title: 'Supported independent living',
    img: '/images/drill.jpg', alt: 'A woman with a cordless drill and tool belt, ready for jobs around the home', imgStyle: 'object-position:50% 38%',
    text: 'Support for people with higher needs to live as independently as possible, in a safe and appropriate home environment.',
    items: ['Everyday support in the home', 'Building independent living skills', 'Help keeping routines on track'],
    ask: 'Ask about independent living',
  },
  {
    id: 'svc-community-access', slug: 'community-access', icon: 'i-people',
    title: 'Community access and group activities',
    img: '/images/swing1.jpg', alt: 'A young woman relaxing on a basket swing at a local park', imgStyle: 'transform:scale(1.9);transform-origin:46% 47%',
    text: 'Get out and about, try new things and meet other people in your community through outings, group activities and regular get-togethers.',
    items: ['Social outings', 'Group activities and gatherings', 'Exploring hobbies and interests'],
    ask: 'Ask about community access',
  },
  {
    id: 'svc-short-medium-stay', slug: 'short-medium-stay', icon: 'i-door',
    title: 'Short and medium stay accommodation',
    img: '/images/sunset.jpg', alt: 'A walk along the beach at sunset', imgStyle: 'object-position:60% 62%',
    text: 'Temporary accommodation in a comfortable, supportive environment for when you need it.',
    items: ['Short-term stays', 'Medium-term stays while longer-term housing is arranged', 'Support available throughout your stay'],
    ask: 'Ask about accommodation',
  },
  {
    id: 'svc-in-home', slug: 'in-home', icon: 'i-home',
    title: 'In-home services',
    img: '/images/sewn_bag.jpg', alt: 'A smiling young woman showing off the bag she sewed herself', imgStyle: 'object-position:50% 25%',
    text: 'Flexible, comprehensive support for you or your loved one in the comfort of your own home.',
    items: ['Support at times that suit your routine', 'Personal and household help', 'Company and a friendly face'],
    ask: 'Ask about in-home services',
  },
  {
    id: 'svc-shopping-domestic', slug: 'shopping-domestic', icon: 'i-bag',
    title: 'Shopping and domestic duties',
    img: '/images/roses.jpg', alt: 'A woman smiling while holding a vase of yellow roses', imgStyle: 'object-position:55% 35%',
    text: 'Let us take care of the shopping, errands and household chores so you have more time for the things you love.',
    items: ['Grocery shopping', 'Running errands', 'Cleaning and laundry'],
    ask: 'Ask about shopping and domestic help',
  },
  {
    id: 'svc-appointments', slug: 'appointments', icon: 'i-calendar',
    title: 'Assistance with getting to appointments',
    img: '/images/bench.jpg', alt: 'A man in a cap and sunglasses sitting on a bench by the water', imgStyle: 'object-position:50% 40%',
    text: 'Reliable transport and support to get you to appointments, social catch-ups and activities.',
    items: ['Medical and therapy appointments', 'Social events and catch-ups', 'Activities and outings'],
    ask: 'Ask about transport support',
  },
  {
    id: 'svc-respite', slug: 'respite', icon: 'i-thumb',
    title: 'Respite',
    img: '/images/swing2.jpg', alt: 'Swinging at a beachside playground on a sunny afternoon', imgStyle: 'transform:scale(1.35);transform-origin:42% 52%',
    text: 'Everyone needs a break sometimes. Respite gives carers and participants time to rest and recharge, with a range of options to suit your situation.',
    items: ['Short breaks for carers', 'Time away for participants', 'Planned or flexible arrangements'],
    ask: 'Ask about respite',
  },
];
---
<Layout page="services" title="Our services | Connectivity Care Solutions" description="NDIS support coordination, daily living, independent living, community access, accommodation, in-home help, transport and respite in Eleebana, NSW.">
  <section class="svc-hero">
    <div class="heart-mark" aria-hidden="true"><svg viewBox="0 0 100 92"><use href="#i-heart"/></svg></div>
    <div class="wrap center">
      <h1>Our Services</h1>
      <p class="intro">Considerate, purposeful disability support that helps participants enjoy a more independent life. No one size fits all, so every service is tailored to the person.</p>
      <p class="label">Our services include:</p>
      <div class="svc-grid">
        {services.map((s) => (
          <article class="svc-card" id={s.id}>
            <span class="svc-icon"><svg><use href={`#${s.icon}`}/></svg></span>
            <figure class="svc-photo"><img src={s.img} alt={s.alt} style={s.imgStyle} loading="lazy"></figure>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
            <ul>
              {s.items.map((item) => <li><svg class="ico"><use href="#i-check"/></svg>{item}</li>)}
            </ul>
            <div class="more">
              {s.more && <a href="#support-coordination">Read more<svg class="ico"><use href="#i-chevron"/></svg></a>}
              <a href={`/contact?service=${s.slug}`}>{s.ask}<svg class="ico"><use href="#i-chevron"/></svg></a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="feature" id="support-coordination">
    <div class="heart-mark" aria-hidden="true"><svg viewBox="0 0 100 92"><use href="#i-heart"/></svg></div>
    <div class="wrap feature-body">
      <h2>NDIS Support Coordination</h2>
      <p class="lede">NDIS Support Coordination is about helping you make the most of your NDIS plan and ensuring your supports work together to help you achieve your goals.</p>
      <p>A Support Coordinator works alongside you to understand what you want to achieve, connect you with suitable service providers, and help you navigate the NDIS system. We can assist with understanding your plan, coordinating your supports, building your confidence and independence, and resolving issues that may arise along the way.</p>
      <p>Our role is to support you to make informed choices and have greater control over your supports. We don't make decisions for you &mdash; instead, we provide guidance, information and practical assistance so you can make the choices that are right for you.</p>
      <p>We can also help coordinate communication between your providers, monitor whether your supports are meeting your needs, identify gaps in your services, and assist you to prepare for plan reviews or changes in circumstances.</p>
      <p class="callout">Most importantly, Support Coordination is participant-focused. We take the time to understand your individual circumstances, preferences and goals and work with you at your own pace.</p>
      <p>Whether you're new to the NDIS or have been using your plan for some time, Support Coordination can provide the practical guidance and connection you need to use your plan effectively and work towards greater choice, confidence and independence.</p>
      <div class="btn-row"><a class="btn" href="/contact?service=support-coordination">Ask about Support Coordination</a></div>
    </div>
  </section>

  <section class="cta-band">
    <div class="heart-mark" aria-hidden="true"><svg viewBox="0 0 100 92"><use href="#i-heart"/></svg></div>
    <div class="wrap">
      <h2>Not sure which service you need?</h2>
      <p>Tell us a little about your situation and we'll help you work out the right mix of supports.</p>
      <div class="btn-row">
        <a class="btn" href="/contact">Contact Us</a>
        <a class="btn btn-ghost" href="tel:+61488905457">Call +61 488 905 457</a>
      </div>
    </div>
  </section>
</Layout>
