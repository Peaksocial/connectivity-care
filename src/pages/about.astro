---
import Layout from '../layouts/Layout.astro';
---
<Layout page="about" title="About us | Connectivity Care Solutions" description="Registered NDIS provider in Eleebana, NSW. Meet our founder Susan and learn about our mission, vision and values.">
  <section class="page-hero">
    <div class="wrap">
      <h1>About us</h1>
      <p class="lede">We're a registered NDIS provider in Eleebana, NSW, built on a genuine commitment to making a positive difference in people's lives.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap story">
      <div>
        <h2>Our story</h2>
        <p>Connectivity Care Solutions began in 2022. Our founder, Susan, wanted to offer support that looks after a person's overall wellbeing, not just a list of tasks.</p>
        <p>Hard work, a love for what we do, and the trust of participants, their families and friends are what keep us going.</p>
        <p>We're a registered provider and fully compliant with NDIS regulations and standards, so you can feel confident in the support you receive.</p>
        <div class="founder">
          <div class="monogram" aria-hidden="true">S</div>
          <div><strong>Susan</strong><span>Founder, Connectivity Care Solutions</span></div>
        </div>
      </div>
      <figure class="ph"><img src="/images/story.jpg" alt="Portrait of a smiling woman with long blonde hair" style="object-position:50% 35%"></figure>
    </div>
  </section>

  <section class="section tint">
    <div class="wrap mv">
      <div class="mv-panel">
        <h2>Our mission</h2>
        <p>We empower people by supporting their independence and connecting them with their community.</p>
        <p>With Connectivity Care, you're not alone, and you never have to be. We partner with you so you can live freely in an inclusive community where you're valued and supported.</p>
      </div>
      <figure class="ph"><img src="/images/cafe.jpg" alt="A man smiling at an outdoor café table" style="object-position:50% 40%"></figure>
      <div class="mv-panel">
        <h2>Our vision</h2>
        <p>A society that sees beyond disability, where people are empowered to build their independence at home and in their community.</p>
        <p>We aim to be one of the leading NDIS registered providers, setting new standards for quality care and innovation.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>What guides us</h2>
        <p class="lede">Five values shape every shift, every conversation and every plan.</p>
      </div>
      <ul class="values">
        <li><div class="value-icon"><svg class="icon"><use href="#i-users"/></svg></div><h3>Respect</h3><p>We listen first and honour each person's choices, background and privacy.</p></li>
        <li><div class="value-icon"><svg class="icon"><use href="#i-heart"/></svg></div><h3>Care and compassion</h3><p>Support delivered with warmth, patience and genuine kindness.</p></li>
        <li><div class="value-icon"><svg class="icon"><use href="#i-shield"/></svg></div><h3>Integrity</h3><p>We're honest and transparent with participants and their families.</p></li>
        <li><div class="value-icon"><svg class="icon"><use href="#i-sun"/></svg></div><h3>Uplifting environment</h3><p>We create spaces where people feel encouraged, valued and free to grow.</p></li>
        <li><div class="value-icon"><svg class="icon"><use href="#i-award"/></svg></div><h3>Qualified staff</h3><p>Our team brings the right training and experience to every shift.</p></li>
      </ul>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="wrap">
      <div class="cta">
        <svg class="cta-heart icon-fill" viewBox="0 0 24 24" aria-hidden="true"><use href="#i-heart"/></svg>
        <div>
          <h2>See how we can support you</h2>
          <p>We offer a range of person-centred services because we know one size doesn't fit all.</p>
        </div>
        <div class="btn-row">
          <a class="btn btn-light" href="/services">View our services</a>
          <a class="btn btn-ghost" href="/contact">Contact us</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
