---
import Layout from '../layouts/Layout.astro';
---
<Layout page="contact" title="Contact us | Connectivity Care Solutions" description="Call +61 488 905 457 or send us a message. Connectivity Care Solutions, 5 Park Dr, Eleebana NSW 2282.">
  <section class="page-hero">
    <div class="wrap">
      <h1>Contact us</h1>
      <p class="lede">Good communication is at the heart of good support. If you need help with your NDIS plan or want to explore your options, give us a call or send us a message.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap contact-grid">
      <div>
        <h2>How to reach us</h2>
        <ul class="contact-items">
          <li>
            <span class="ci-icon"><svg class="icon"><use href="#i-phone"/></svg></span>
            <div><span class="ci-label">Phone</span><a href="tel:+61488905457">+61 488 905 457</a></div>
          </li>
          <li>
            <span class="ci-icon"><svg class="icon"><use href="#i-mail"/></svg></span>
            <div><span class="ci-label">Email</span><a href="mailto:susan@connectivitycaresolutions.com.au">susan@connectivitycaresolutions.com.au</a></div>
          </li>
          <li>
            <span class="ci-icon"><svg class="icon"><use href="#i-pin"/></svg></span>
            <div><span class="ci-label">Address</span><a href="https://maps.app.goo.gl/4mhTXmNiUf1FmtQf7" target="_blank" rel="noopener">5 Park Dr, Eleebana NSW 2282</a></div>
          </li>
        </ul>
        <h3>Follow along</h3>
        <div class="socials">
          <a class="social-btn" href="https://www.facebook.com/connectivitycaresolutions.com.au/" target="_blank" rel="noopener" aria-label="Connectivity Care Solutions on Facebook"><svg class="icon"><use href="#i-facebook"/></svg></a>
          <a class="social-btn" href="https://www.instagram.com/connectivitycare_solutions" target="_blank" rel="noopener" aria-label="Connectivity Care Solutions on Instagram"><svg class="icon"><use href="#i-instagram"/></svg></a>
        </div>
      </div>

      <div class="form-card">
        <form id="contact-form" novalidate>
          <h2>Send us a message</h2>
          <p class="form-note">All fields are required. We'll get back to you as soon as we can.</p>
          <div class="field-row">
            <div class="field">
              <label for="f-name">Your name</label>
              <input id="f-name" name="name" type="text" autocomplete="name" required aria-describedby="name-error">
              <p class="error" id="name-error" aria-live="polite"></p>
            </div>
            <div class="field">
              <label for="f-phone">Phone number</label>
              <input id="f-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" required aria-describedby="phone-error">
              <p class="error" id="phone-error" aria-live="polite"></p>
            </div>
          </div>
          <div class="field">
            <label for="f-email">Email</label>
            <input id="f-email" name="email" type="email" autocomplete="email" required aria-describedby="email-error">
            <p class="error" id="email-error" aria-live="polite"></p>
          </div>
          <div class="field">
            <label for="f-message">Message</label>
            <textarea id="f-message" name="message" required aria-describedby="message-error"></textarea>
            <p class="error" id="message-error" aria-live="polite"></p>
          </div>
          <button class="btn btn-primary" type="submit">Send message</button>
        </form>
        <div class="success" id="form-success" tabindex="-1" hidden>
          <div class="big-icon"><svg class="icon"><use href="#i-check-circle"/></svg></div>
          <h2>Message sent</h2>
          <p>Thanks, <span id="success-name"></span>. We've received your message and will be in touch soon.</p>
          <div class="btn-row" style="justify-content:center"><button class="btn btn-outline" type="button" id="send-another">Send another message</button></div>
        </div>
      </div>
    </div>
  </section>

<script>
// "Ask about X" buttons link here as /contact?service=<slug>
const SERVICES = {
  'support-coordination': 'NDIS Support Coordination',
  'daily-living': 'assistance with daily living',
  'independent-living': 'supported independent living',
  'community-access': 'community access and group activities',
  'short-medium-stay': 'short and medium stay accommodation',
  'in-home': 'in-home services',
  'shopping-domestic': 'shopping and domestic duties',
  'appointments': 'help getting to appointments',
  'respite': 'respite'
};
const ask = SERVICES[new URLSearchParams(location.search).get('service')];
if (ask) {
  const msg = document.getElementById('f-message');
  if (!msg.value.trim()) msg.value = "Hi, I'd like to find out more about " + ask + ".";
}

// Contact form (mockup: validates and shows a confirmation, nothing is sent)
const form = document.getElementById('contact-form');
const success = document.getElementById('form-success');
const rules = {
  name: v => v.trim() ? '' : 'Enter your name',
  phone: v => !v.trim() ? 'Enter your phone number' : (v.replace(/\D/g,'').length >= 8 ? '' : 'Enter a phone number with at least 8 digits'),
  email: v => !v.trim() ? 'Enter your email address' : (/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v.trim()) ? '' : 'Enter an email address like name@example.com'),
  message: v => v.trim() ? '' : 'Enter your message'
};
form.addEventListener('submit', e => {
  e.preventDefault();
  let firstBad = null;
  ['name','phone','email','message'].forEach(key => {
    const el = form.elements[key];
    const msg = rules[key](el.value);
    document.getElementById(key + '-error').textContent = msg;
    el.setAttribute('aria-invalid', msg ? 'true' : 'false');
    if (msg && !firstBad) firstBad = el;
  });
  if (firstBad) { firstBad.focus(); return; }
  document.getElementById('success-name').textContent = form.elements.name.value.trim().split(/\s+/)[0];
  form.hidden = true;
  success.hidden = false;
  success.focus();
});
form.querySelectorAll('input, textarea').forEach(el => el.addEventListener('input', () => {
  if (el.getAttribute('aria-invalid') === 'true' && !rules[el.name](el.value)) {
    el.setAttribute('aria-invalid','false');
    document.getElementById(el.name + '-error').textContent = '';
  }
}));
document.getElementById('send-another').addEventListener('click', () => {
  form.reset();
  success.hidden = true;
  form.hidden = false;
  form.elements.name.focus();
});
</script>
</Layout>
